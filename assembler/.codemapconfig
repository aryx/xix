// over the shared Lexer_asm.mll, Parse_asmX.ml (the tokens translated,
// the preprocessor hooked in), Ast_asmX.ml in objects/; X is 5 (ARM),
// 6 (amd64), 7 (ARM64), v (MIPS), i (RISC-V, also j for 64 bits).
local skeletons = import '../skeletons.libsonnet';

// Parse_asmX.ml's own skeleton: the lexer's tokens translated, the
// grammar called, under the preprocessor
local parse_asm(x, arch, no_cpp=true) = {
  name: 'Parsing ' + arch + ' assembly, under cpp',
  bones: [
    { at: 'Parse_asm' + x + '.ml:def:parse', role: 'the entry: cpp hooks, then the grammar' },
    { at: 'Parse_asm' + x + '.ml:def:token', role: "Lexer_asm's tokens to this parser's" },
    { at: 'Parser_asm' + x + '.mly:def:program', role: 'the grammar: lines of Ast_asm' + x },
  ] + (if no_cpp then [{ at: 'Parse_asm' + x + '.ml:def:parse_no_cpp', role: 'no cpp: for tests' }] else []),
  joints: [
    { from: 'Parse_asm' + x + '.ml:def:parse', to: 'Parse_asm' + x + '.ml:def:token', say: 'the lexer hook' },
    { from: 'Parse_asm' + x + '.ml:def:parse', to: 'Parser_asm' + x + '.mly:def:program', say: 'the parser hook' },
  ] + (if no_cpp then [{ from: 'Parse_asm' + x + '.ml:def:parse_no_cpp', to: 'Parser_asm' + x + '.mly:def:program', say: 'directly' }] else []),
};
local parse_file(arch, digest) = {
